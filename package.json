{
  "name": "debrute",
  "version": "0.0.4",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Debrute browser-first local creative production workbench.",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.2.2 <12"
  },
  "scripts": {
    "postinstall": "pnpm validate:canvas-text-font-subset",
    "prebuild": "pnpm validate:canvas-text-font-subset",
    "build": "pnpm generate:control-protocol && pnpm check:typescript && pnpm build:artifacts",
    "predev": "pnpm validate:canvas-text-font-subset",
    "build:artifacts": "pnpm --filter @debrute/desktop build:artifacts",
    "clean": "node scripts/clean.mjs",
    "brand:sync": "node scripts/sync-brand-assets.mjs",
    "pack:local": "pnpm --filter @debrute/desktop pack:local",
    "install:local": "pnpm --filter @debrute/desktop install:local",
    "package:photoshop-uxp-plugin": "node scripts/package-photoshop-uxp-plugin.mjs",
    "package:photoshop-plugin": "pnpm package:photoshop-uxp-plugin",
    "dist": "pnpm --filter @debrute/desktop dist",
    "check": "pnpm generate:control-protocol && pnpm check:typescript",
    "check:rust": "cargo fmt --all -- --check && node scripts/run-cargo-with-native-raster.mjs -- clippy --workspace --lib --bins -- -D warnings",
    "check:rust:all": "cargo fmt --all -- --check && node scripts/run-cargo-with-native-raster.mjs -- clippy --workspace --all-targets --features test-support,native-watcher-probe -- -D warnings",
    "check:typescript": "tsc -b tsconfig.build.json --pretty false",
    "dev": "tsx --tsconfig tsconfig.base.json scripts/dev-workbench.ts",
    "predev:electron": "pnpm validate:canvas-text-font-subset",
    "dev:electron": "pnpm --filter @debrute/desktop dev:electron",
    "generate:control-protocol": "node scripts/run-cargo-with-native-raster.mjs -- test -p debrute-runtime --lib export_bindings",
    "preview": "pnpm --filter @debrute/web preview",
    "test": "pnpm test:layout && vitest run",
    "test:rust": "node scripts/test-rust.mjs",
    "test:rust:native-watcher": "node scripts/test-native-project-watcher.mjs",
    "test:unit": "vitest run --project=unit-* --project=contracts",
    "test:dom": "vitest run --project=dom-web",
    "test:release": "vitest run --project=release",
    "test:watch": "vitest --project=unit-* --project=contracts --project=dom-web",
    "test:profile": "vitest run",
    "test:stability": "vitest run --sequence.shuffle.files --sequence.seed=104729 && vitest run --sequence.shuffle.files --sequence.seed=130363 && vitest run --sequence.shuffle.files --sequence.seed=155921",
    "test:coverage": "vitest run --coverage --project=unit-* --project=dom-web --project=contracts",
    "test:canvas-text": "vitest run --tagsFilter=canvas-text",
    "test:layout": "tsx scripts/check-test-layout.ts",
    "verify:browser": "node scripts/verify-workbench-browser.mjs",
    "lint:arch": "node scripts/check-architecture.mjs",
    "native:raster:prepare": "node scripts/prepare-native-raster.mjs",
    "build:canvas-text-font-subset": "node scripts/build-canvas-text-font-subset-wasm.mjs",
    "validate:canvas-text-font-subset": "node scripts/validate-canvas-text-font-subset-wasm.mjs",
    "doctor": "node scripts/doctor.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:all": "node scripts/verify.mjs --all-rust-targets"
  },
  "dependencies": {
    "@debrute/runtime-control-client": "workspace:*"
  },
  "devDependencies": {
    "@debrute/architecture-rules": "workspace:*",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.13.1",
    "@vitest/coverage-v8": "^4.1.10",
    "adm-zip": "^0.5.18",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
