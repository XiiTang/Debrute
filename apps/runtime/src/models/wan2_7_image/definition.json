{
  "id": "wan2.7-image",
  "kind": "image",
  "summary": "Image generation, editing, or groups with 0–9 inputs; single mode returns 1–4 images and group mode up to 12; 1K/2K or 768²–2048² total pixels; each input is at most 20 MB.",
  "defaultBaseUrl": "https://dashscope.aliyuncs.com/api/v1",
  "defaultRequestModelId": "wan2.7-image",
  "argumentsSchema": {
    "type": "object",
    "properties": {
      "prompt": {
        "type": "string",
        "maxLength": 5000
      },
      "image": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "debruteImageInput": true,
        "description": "Ordered absolute or CLI-working-directory-relative image paths, public http(s) URLs, or data:image URIs.",
        "maxItems": 9
      },
      "size": {
        "type": "string"
      },
      "n": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12
      },
      "watermark": {
        "type": "boolean",
        "default": false
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "thinking_mode": {
        "type": "boolean"
      },
      "enable_sequential": {
        "type": "boolean"
      },
      "bbox_list": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "maxItems": 2
        }
      }
    },
    "required": [
      "prompt"
    ]
  }
}
