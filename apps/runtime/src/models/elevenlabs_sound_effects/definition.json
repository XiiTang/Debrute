{
  "id": "elevenlabs-sound-effects",
  "kind": "sound-effect",
  "summary": "One sound effect from 0.5 to 30 seconds with optional looping and prompt influence from 0 to 1; output format availability depends on the ElevenLabs subscription.",
  "defaultBaseUrl": "https://api.elevenlabs.io/v1",
  "defaultRequestModelId": "eleven_text_to_sound_v2",
  "argumentsSchema": {
    "type": "object",
    "required": [
      "text"
    ],
    "properties": {
      "text": {
        "type": "string"
      },
      "duration_seconds": {
        "type": "number",
        "minimum": 0.5,
        "maximum": 30
      },
      "loop": {
        "type": "boolean"
      },
      "prompt_influence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "output_format": {
        "type": "string"
      }
    }
  }
}
