{
  "id": "doubao-seedance-2-0-260128",
  "kind": "video",
  "summary": "4–15-second or model-timed video at 480p, 720p, or 1080p from text, first/last frames, image/video/audio references, audio driving, extension, or editing; optional generated audio; local video upload is unavailable.",
  "defaultBaseUrl": "https://ark.cn-beijing.volces.com/api/v3",
  "defaultRequestModelId": "doubao-seedance-2-0-260128",
  "argumentsSchema": {
    "type": "object",
    "properties": {
      "prompt": {
        "type": "string",
        "description": "Required video brief."
      },
      "intent": {
        "type": "string",
        "default": "generate",
        "enum": [
          "generate",
          "reference",
          "audio_driven",
          "extend",
          "edit"
        ],
        "description": "High-level Debrute video intent. Debrute derives Seedance content routing internally."
      },
      "references": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "media_type": {
              "type": "string",
              "enum": [
                "image",
                "video",
                "audio",
                "mask"
              ]
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        }
      },
      "callback_url": {
        "type": "string"
      },
      "return_last_frame": {
        "type": "boolean"
      },
      "execution_expires_after": {
        "type": "integer"
      },
      "generate_audio": {
        "type": "boolean"
      },
      "tools": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "safety_identifier": {
        "type": "string"
      },
      "resolution": {
        "type": "string",
        "enum": [
          "480p",
          "720p",
          "1080p"
        ]
      },
      "ratio": {
        "type": "string",
        "enum": [
          "16:9",
          "4:3",
          "1:1",
          "3:4",
          "9:16",
          "21:9",
          "adaptive"
        ]
      },
      "duration": {
        "type": "integer",
        "oneOf": [
          {
            "const": -1,
            "description": "Let Seedance select the duration."
          },
          {
            "minimum": 4,
            "maximum": 15
          }
        ]
      },
      "frames": {
        "type": "integer"
      },
      "seed": {
        "type": [
          "integer",
          "string",
          "null"
        ]
      },
      "camera_fixed": {
        "type": "boolean"
      },
      "watermark": {
        "type": "boolean",
        "default": false
      },
      "extend_direction": {
        "type": "string",
        "enum": [
          "forward",
          "backward"
        ]
      },
      "edit_scope": {
        "type": "string"
      }
    },
    "required": [
      "prompt"
    ]
  }
}
