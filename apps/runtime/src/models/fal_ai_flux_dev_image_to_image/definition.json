{
  "id": "fal-ai/flux/dev/image-to-image",
  "kind": "image",
  "summary": "Image-to-image generation from exactly one reference, with strength and FLUX controls, one or more outputs, and JPEG/PNG output; no multi-reference input.",
  "defaultBaseUrl": "https://fal.run",
  "defaultRequestModelId": "fal-ai/flux/dev/image-to-image",
  "argumentsSchema": {
    "type": "object",
    "properties": {
      "prompt": {
        "type": "string"
      },
      "image_url": {
        "type": "string",
        "debruteImageInput": true,
        "description": "One absolute or CLI-working-directory-relative image path, public http(s) URL, or data:image URI."
      },
      "strength": {
        "type": "number"
      },
      "num_inference_steps": {
        "type": "integer"
      },
      "seed": {
        "type": "integer"
      },
      "guidance_scale": {
        "type": "number"
      },
      "num_images": {
        "type": "integer"
      },
      "enable_safety_checker": {
        "type": "boolean"
      },
      "output_format": {
        "type": "string",
        "enum": [
          "jpeg",
          "png"
        ]
      },
      "acceleration": {
        "type": "string",
        "enum": [
          "none",
          "regular",
          "high"
        ]
      },
      "sync_mode": {
        "type": "boolean"
      }
    },
    "required": [
      "prompt",
      "image_url"
    ]
  }
}
