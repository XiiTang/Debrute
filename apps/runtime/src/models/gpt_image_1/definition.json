{
  "id": "gpt-image-1",
  "kind": "image",
  "summary": "Image generation/editing at 1024×1024, 1024×1536, or 1536×1024 with low/medium/high/auto quality and PNG/JPEG/WebP output; transparent background is supported only with compatible output settings.",
  "defaultBaseUrl": "https://api.openai.com/v1",
  "defaultRequestModelId": "gpt-image-1",
  "argumentsSchema": {
    "type": "object",
    "properties": {
      "prompt": {
        "type": "string"
      },
      "image": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "debruteImageInput": true,
        "description": "Ordered absolute or CLI-working-directory-relative image paths, public http(s) URLs, or data:image URIs."
      },
      "mask": {
        "type": "string",
        "debruteImageInput": true,
        "description": "Absolute or CLI-working-directory-relative image path, public http(s) URL, or data:image URI."
      },
      "size": {
        "type": "string",
        "enum": [
          "auto",
          "1024x1024",
          "1024x1536",
          "1536x1024"
        ]
      },
      "quality": {
        "type": "string",
        "enum": [
          "auto",
          "low",
          "medium",
          "high"
        ]
      },
      "background": {
        "type": "string",
        "enum": [
          "auto",
          "opaque",
          "transparent"
        ]
      },
      "input_fidelity": {
        "type": "string",
        "enum": [
          "low",
          "high"
        ]
      },
      "output_format": {
        "type": "string",
        "enum": [
          "png",
          "jpeg",
          "webp"
        ]
      },
      "output_compression": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      },
      "moderation": {
        "type": "string"
      },
      "n": {
        "type": "integer",
        "minimum": 1
      },
      "user": {
        "type": "string"
      }
    },
    "required": [
      "prompt"
    ]
  }
}
