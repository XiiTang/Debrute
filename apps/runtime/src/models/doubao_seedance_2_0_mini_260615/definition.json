{
  "id": "doubao-seedance-2-0-mini-260615",
  "kind": "video",
  "summary": "Lower-cost 4–15-second or model-timed video at 480p or 720p from text, first/last frames, image/video/audio references, audio driving, extension, or editing; optional generated audio and pure-text Web Search; no 1080p.",
  "defaultBaseUrl": "https://ark.cn-beijing.volces.com/api/v3",
  "defaultRequestModelId": "doubao-seedance-2-0-mini-260615",
  "argumentsSchema": {
    "type": "object",
    "properties": {
      "prompt": {
        "type": "string",
        "description": "Required video brief."
      },
      "intent": {
        "type": "string",
        "default": "generate",
        "enum": [
          "generate",
          "reference",
          "audio_driven",
          "extend",
          "edit"
        ],
        "description": "High-level Debrute video intent. Debrute derives the official Seedance content roles internally."
      },
      "references": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "media_type": {
              "type": "string",
              "enum": [
                "image",
                "video",
                "audio"
              ]
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        }
      },
      "generate_audio": {
        "type": "boolean"
      },
      "tools": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "web_search"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      },
      "return_last_frame": {
        "type": "boolean"
      },
      "resolution": {
        "type": "string",
        "enum": [
          "480p",
          "720p"
        ]
      },
      "ratio": {
        "type": "string",
        "enum": [
          "16:9",
          "4:3",
          "1:1",
          "3:4",
          "9:16",
          "21:9",
          "adaptive"
        ]
      },
      "duration": {
        "type": "integer",
        "oneOf": [
          {
            "const": -1,
            "description": "Let Seedance select the duration."
          },
          {
            "minimum": 4,
            "maximum": 15
          }
        ]
      },
      "watermark": {
        "type": "boolean",
        "default": false
      }
    },
    "required": [
      "prompt"
    ]
  }
}
