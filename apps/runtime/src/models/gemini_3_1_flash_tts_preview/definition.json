      "speech_config"
    ],
    "properties": {
      "text": {
        "type": "string"
      },
      "speech_config": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "voice": {
                  "type": "string"
                },
                "language": {
                  "type": "string"
                }
              },
              "required": [
                "voice"
              ]
            },
            {
              "type": "object",
              "properties": {
                "speaker": {
                  "type": "string"
                },
                "voice": {
                  "type": "string"
                },
                "language": {
                  "type": "string"
                }
              },
              "required": [
                "speaker",
                "voice"
              ]
            }
          ]
        },
        "maxItems": 2
      }
    }
  }
}
