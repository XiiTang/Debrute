{
  "id": "gemini-3-1-flash-tts-preview",
  "kind": "tts",
  "summary": "Preview TTS from text with one or two speakers, 30 voices, a 32k context, and raw 24 kHz mono PCM output; Debrute currently handles only completed, non-streaming responses.",
  "defaultBaseUrl": "https://generativelanguage.googleapis.com/v1beta",
  "defaultRequestModelId": "gemini-3.1-flash-tts-preview",
  "argumentsSchema": {
