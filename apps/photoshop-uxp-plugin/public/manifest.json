{
  "manifestVersion": 5,
  "id": "com.debrute.photoshop",
  "name": "Debrute Photoshop",
  "version": "0.0.4",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.4.0",
    "data": {
      "apiVersion": 2,
      "loadEvent": "startup"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "debrutePhotoshopPanel",
      "label": {
        "default": "Debrute"
      },
      "minimumSize": {
        "width": 300,
        "height": 420
      },
      "maximumSize": {
        "width": 640,
        "height": 900
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 560
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 560
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "plugin"
  }
}
