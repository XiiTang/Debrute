{
  "name": "@debrute/desktop",
  "version": "0.0.4",
  "license": "Apache-2.0",
  "private": true,
  "type": "commonjs",
  "description": "Debrute Product Desktop host and platform installer payload.",
  "author": "Debrute",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "pnpm --filter @debrute/web build && pnpm build:runtime && pnpm check && pnpm bundle",
    "build:artifacts": "pnpm --filter @debrute/web build:artifacts && pnpm build:runtime && pnpm bundle",
    "build:electron:dev": "node scripts/bundle-electron.mjs --skip-product-seed",
    "build:runtime": "node ../../scripts/prepare-canvas-video-tools.mjs --profile release && node ../../scripts/run-cargo-with-native-raster.mjs -- build -p debrute-runtime --release --bins",
    "bundle": "node scripts/bundle-electron.mjs",
    "check": "tsc -p tsconfig.json --pretty false",
    "pack:local": "pnpm build && node scripts/package-local-macos.mjs",
    "install:local": "pnpm pack:local && node ../../scripts/install-local-macos.mjs",
    "dist": "pnpm build && node scripts/build-product-installer.mjs",
    "dev:electron": "tsx ../../scripts/dev-electron-workbench.ts"
  },
  "build": {
    "appId": "io.github.xiitang.debrute",
    "productName": "Debrute",
    "executableName": "debrute",
    "electronVersion": "42.4.0",
    "asar": true,
    "asarUnpack": [],
    "afterSign": "scripts/notarize-macos-app.cjs",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "!dist-electron/product-seed/**/*",
      "!dist-electron/**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-electron/product-seed",
        "to": "product-seed"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "XiiTang",
        "repo": "Debrute",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "executableName": "Debrute",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "signIgnore": [
        "Resources/product-seed/runtime/Debrute Runtime\\.app/.*",
        "Resources/product-seed/runtime/debrute"
      ],
      "notarize": false,
      "target": [
        "dir"
      ]
    },
    "win": {
      "executableName": "Debrute",
      "artifactName": "debrute-installer-${version}-windows-${arch}.${ext}",
      "signExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "guid": "708c37b7-2547-5a47-9bfa-42bb13156a66",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "Debrute",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "include": "build/product-installer.nsh",
      "runAfterFinish": true,
      "uninstallDisplayName": "Debrute Product"
    }
  },
  "dependencies": {
    "@debrute/app-protocol": "workspace:*",
    "@debrute/runtime-control-client": "workspace:*"
  },
  "devDependencies": {
    "electron": "42.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
